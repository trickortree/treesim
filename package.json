{
  "name": "hypergamous-tree-chopping-simulator-3",
  "version": "1.1.1",
  "description": "Hypergamous Tree Chopping Simulator 3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.trickortree.treesim",
    "productName": "Hypergamous Tree Chopping Simulator 3",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "trickortree",
      "repo": "treesim",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotes": "Hypergamous Tree Chopping Simulator 3 - Update 1.1.1\n\n- Fixed first-time username registration during intermittent Supabase network latency.\n- Username claims now retry transient fetch, timeout, and server errors before showing a clear failure message.\n- Existing 1.1.0 gameplay systems remain unchanged."
    }
  }
}
