{
  "name": "hypergamous-tree-chopping-simulator-3",
  "version": "1.1.4",
  "description": "Hypergamous Tree Chopping Simulator 3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.trickortree.treesim",
    "productName": "Hypergamous Tree Chopping Simulator 3",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "trickortree",
      "repo": "treesim",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotes": "Hypergamous Tree Chopping Simulator 3 - Update 1.1.4\n\n- Added an X button for local-only play when leaderboard registration is unavailable.\n- Fixed leaderboard reads with the same native HTTPS fallback used by username registration.\n- Registered players now appear in the leaderboard even when the Supabase SDK fetch path fails."
    }
  }
}
