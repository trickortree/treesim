rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public leaderboard rows. Owner can create their own row once and update
    // their own stats, but the username field is immutable after creation.
    match /players/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$');
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    // Reservation docs keyed by lowercase username, enforcing global uniqueness
    // the same way the Postgres `lower(username)` unique index did.
    match /usernames/{lowerUsername} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Player-to-player axe trades. Only the two participants can read a trade.
    // Status moves one way: open -> accepted/declined (recipient) or
    // open -> cancelled (sender). `settled` flips false -> true once, which is
    // what stops the sender from being paid / refunded twice.
    match /trades/{tradeId} {
      allow read: if request.auth != null
        && (resource.data.from_uid == request.auth.uid || resource.data.to_uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from_uid == request.auth.uid
        && request.resource.data.to_uid is string
        && request.resource.data.to_uid != request.auth.uid
        && request.resource.data.from_name is string
        && request.resource.data.to_name is string
        && request.resource.data.status == 'open'
        && request.resource.data.settled == false
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.item.skinName is string
        && request.resource.data.item.condition is string;
      allow update: if request.auth != null && (
        // recipient accepts or declines an open trade
        (resource.data.to_uid == request.auth.uid
          && resource.data.status == 'open'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolved_at']))
        // sender cancels an open trade (and takes the axe back in the same write)
        || (resource.data.from_uid == request.auth.uid
          && resource.data.status == 'open'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.settled == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'settled', 'resolved_at']))
        // sender collects payment / refund after the recipient answered
        || (resource.data.from_uid == request.auth.uid
          && resource.data.status in ['accepted', 'declined']
          && resource.data.settled == false
          && request.resource.data.settled == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled']))
      );
      allow delete: if false;
    }

    // Oblivion relic status. No Cloud Functions on the free Spark plan, so
    // the roll happens client-side and this is the only server-enforced
    // guarantee left: total_attempts can only increase by exactly 1 per
    // write, and claimed_by can only ever go from null to a value once
    // (never overwritten), keeping a true single-winner guarantee even
    // though the odds themselves are not independently verified server-side.
    match /meta/oblivion_relic {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.total_attempts == 1
        && (!('claimed_by' in request.resource.data) || request.resource.data.claimed_by == null);
      allow update: if request.auth != null
        && request.resource.data.total_attempts == resource.data.total_attempts + 1
        && (resource.data.get('claimed_by', null) == null
          || request.resource.data.get('claimed_by', null) == resource.data.get('claimed_by', null));
      allow delete: if false;
    }

    // Any other server-authoritative singletons stay fully read-only to clients.
    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
